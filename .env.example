WWEBJS_TEST_REMOTE_ID=XXXXXXXXXX@c.us
WWEBJS_TEST_CLIENT_ID=authenticated
WWEBJS_TEST_MD=1

# Recommended for running the X CLI and bot
PLAYWRIGHT_CHANNEL=chrome
BOT_PREFIX=!
AUTH_STRATEGY=local
HEADLESS=true
DB_PATH=astra.sqlite3

# Bot / session defaults
# PHONE_NUMBER should be in WhatsApp format (e.g., 15551234567 without '+' or formatting)
PHONE_NUMBER=15550000000
# Default session id used by X CLI start if not provided on the command line
DEFAULT_SESSION=default
# Optional human-readable bot name
BOT_NAME=whatsapp-bot