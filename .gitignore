# ==============================================================
# Astra Engine — Python .gitignore
# ==============================================================

# -- Python bytecode ------------------------------------------
__pycache__/
*.py[cod]
*$py.class
*.so

# -- Distribution & packaging ---------------------------------
dist/
build/
*.egg-info/
*.egg
.eggs/
sdist/
wheels/

# -- Virtual environments -------------------------------------
.venv/
venv/
ENV/

# -- IDE & editors --------------------------------------------
.vscode/
.idea/
*.swp
*.swo
*~
.project
.settings/

# -- OS files -------------------------------------------------
.DS_Store
._*
Thumbs.db
ehthumbs.db
Desktop.ini

# -- Testing & coverage ---------------------------------------
.pytest_cache/
.coverage
htmlcov/
.tox/
.nox/

# -- Type checking & linting ----------------------------------
.mypy_cache/
.ruff_cache/
.pytype/

# -- Sphinx docs build ----------------------------------------
docs/_build/

# -- Environment files ----------------------------------------
.env
.env.local
.env.*.local

# -- Astra session & cache data -------------------------------
.astra_sessions/
*.db
*.db-journal

# -- Draft / development directories --------------------------
corastra/
nnew/
x/
wwaa/

# -- Node.js (legacy) -----------------------------------------
node_modules/
package-lock.json
yarn.lock
npm-debug.log*

# -- Misc ------------------------------------------------------
*.tgz
*.log
*.pid
*.seed